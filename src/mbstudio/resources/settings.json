{
  "plot": {
    "figure": {
      "figsize": [
        14.52,
        4.23
      ],
      "dpi": 100,
      "facecolor": "floralwhite",
      "edgecolor": "k",
      "margins": {
        "left": 0.06,
        "right": 0.94,
        "bottom": 0.15,
        "top": 0.94
      }
    },
    "layout": {
      "mosaic": [
        [
          "top"
        ],
        [
          "bottom"
        ]
      ],
      "height_ratios": [
        5,
        2
      ],
      "hspace": 0.15,
      "sharex": true
