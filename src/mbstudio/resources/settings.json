              "layout": {
                "rows": [
                  {
                    "groups": [
                      {
                        "label": "Transition",
                        "orientation": "h",
                        "widgets": [
                          "nu",
                          "gamma"
                        ]
                      },
                      {
                        "label": "Time Scale",
                        "orientation": "h",
                        "widgets": [
                          "t0"
                        ]
                      }
                    ]
                  },
                  {
                    "groups": [
                      {
                        "label": "Medium",
                        "orientation": "v",
                        "widgets": [
                          "l",
                          "n0"
                        ]
                      }
                    ]
                  }
                ]
              },
