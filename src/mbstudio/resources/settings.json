    "axes_style": {
      "zero_line": {
        "color": "k",
        "linestyle": "--",
        "linewidth": 0.75,
        "alpha": 0.6
      },
      "label_font": {
        "fontsize": 13,
        "fontname": "Times New Roman"
      },
      "offset_font": {
        "fontsize": 10,
        "fontname": "Times New Roman"
      },
      "ticks": {
        "direction": "in",
        "labelsize": 11,
        "labelfontfamily": "Times New Roman",
        "left": true,
        "right": false,
        "top": true,
        "bottom": true
      },
      "ticks_major": {
        "length": 3.5,
        "width": 0.7
      },
      "ticks_minor": {
        "length": 1.75,
        "width": 0.5
      },
      "minor_locator": [
        4,
        4
      ],
      "ticks_x": {
        "pad": 5
      },
      "label_pad": [
        null,
        5
      ]
    },
    "markers": {
      "span": {
        "kind": "vspan",
        "visible": false,
        "props": {
          "color": "b",
          "alpha": 0.1
        }
      },
      "span_center": {
        "kind": "vline",
        "visible": false,
        "props": {
          "color": "r",
          "linestyle": "-",
          "linewidth": 0.75,
          "alpha": 0.6
        }
      }
    },
    "panels": {
      "top": {
        "primary": "flux",
        "curves": {
          "data_points": {
            "label": "",
            "unit": "",
            "props": {
              "linestyle": "",
              "marker": "o",
              "markersize": 3,
              "color": "k"
            },
            "name": "Data Points"
          },
          "flux": {
            "label": "F",
            "unit": "\\mathrm{Jy}",
            "props": {
              "color": "b",
              "linestyle": "-",
              "linewidth": 1.25
            },
            "name": "Flux"
          }
        }
      },
      "bottom": {
        "select": "one",
